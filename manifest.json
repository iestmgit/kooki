{
  "manifest_version": 3,
  "name": "Ultra Auto Clicker",
  "version": "1.0",
  "description": "1,000,000 clicks per second with Ctrl+Space",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "start-clicker": {
      "suggested_key": {
        "default": "Ctrl+Space"
      },
      "description": "Start/Stop auto clicker"
    }
  },
  "action": {
    "default_icon": "icon.png"
  }
}
