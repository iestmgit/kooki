{
  "manifest_version": 3,
  "name": "Ultra Auto Clicker",
  "version": "1.0",
  "description": "1,000,000 clicks per second with Ctrl+Space",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "start-clicker": {
      "suggested_key": {
        "default": "Ctrl+Space"
      },
      "description": "Start/Stop auto clicker"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}
